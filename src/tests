import unittest
from src.agents.parser import InvoiceParser
from src.agents.validator import ComplianceValidator

class TestComplianceEngine(unittest.TestCase):
    def test_valid_invoice(self):
        data = {"id": "INV-001", "amount": 500, "tax_code": "SAT_REG_01"}
        parser = InvoiceParser(data)
        structured = parser.parse_to_json()
        
        validator = ComplianceValidator({"max_amount": 1000000})
        self.assertTrue(validator.validate(structured))

    def test_invalid_tax_code(self):
        data = {"id": "INV-002", "amount": 500, "tax_code": "INVALID"}
        parser = InvoiceParser(data)
        structured = parser.parse_to_json()
        
        validator = ComplianceValidator({"max_amount": 1000000})
        self.assertFalse(validator.validate(structured))

